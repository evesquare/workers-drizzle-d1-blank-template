{
	"name": "my-next-app",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "next lint",
		"deploy": "pnpm run db:migrate:dev && opennextjs-cloudflare && wrangler deploy",
		"preview": "opennextjs-cloudflare && wrangler dev",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate:dev": "npx wrangler d1 migrations apply <YOUR_DATABASE_NAME> --local",
		"db:migrate:prod": "NODE_ENV=production drizzle-kit migrate",
		"db:studio:dev": "cross-env LOCAL_DB_PATH=$(find .wrangler/state/v3/d1/miniflare-D1DatabaseObject -type f -name '*.sqlite' -print -quit) drizzle-kit studio",
		"db:studio:prod": "NODE_ENV=production drizzle-kit studio"
	},
	"dependencies": {
		"@radix-ui/react-slot": "^1.1.2",
		"better-auth": "^1.2.4",
		"better-sqlite3": "^11.9.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.41.0",
		"hono": "^4.7.5",
		"lucide-react": "^0.484.0",
		"next": "15.2.3",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"tailwind-merge": "^3.0.2",
		"tw-animate-css": "^1.2.4"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20250321.0",
		"@eslint/eslintrc": "^3",
		"@opennextjs/cloudflare": "^0.5.12",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"cross-env": "^7.0.3",
		"drizzle-kit": "^0.30.5",
		"eslint": "^9",
		"eslint-config-next": "15.2.3",
		"tailwindcss": "^4",
		"typescript": "^5",
		"wrangler": "^4.4.0"
	},
	"pnpm": {
		"ignoredBuiltDependencies": [
			"better-sqlite3",
			"esbuild",
			"sharp",
			"workerd"
		]
	}
}
